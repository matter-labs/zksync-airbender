import Human.RV32
import Image
import ImageMop
/-! Prints the files slop/Slop/RV/Code/<block>.lean (split by lean/gen/words.sh): per code block (function) its
words and one `decode` lemma per distinct word, so that a change in one function only touches its own file.
Two images: `Image` (plain Rust) and `ImageMop` (feature `mop`); a block of `ImageMop` whose bytes equal the
same-named block of `Image` is shared, otherwise it gets its own file `<block>_mop`. -/
open RV
deriving instance Repr for Op, Cond, FieldOp, Instr

def wordAt (bytes : Array (BitVec 8)) (a : Nat) : Word :=
  let b := fun k => (bytes[a + k]!).zeroExtend 32
  b 0 ||| b 1 <<< 8 ||| b 2 <<< 16 ||| b 3 <<< 24

def codeOf (bytes : Array (BitVec 8)) (a size : Nat) : List Word :=
  (List.range (size / 4)).map fun i => wordAt bytes (a + 4 * i)

/-- (block, address, size) of `Image`. -/
def blocks : List (String × Nat × Nat) :=
  [("start", 0, Image.main),  -- _start, _abs_start, _start_rust
   ("main", Image.main, Image.main_size),
   ("inc", Image.u32_inc, Image.u32_inc_size), ("double", Image.u32_double, Image.u32_double_size),
   ("combine", Image.u32_combine, Image.u32_combine_size),
   ("add_mod", Image.m31_add, Image.m31_add_size), ("mul_mod", Image.m31_mul, Image.m31_mul_size),
   ("poly_eval", Image.m31_poly_eval, Image.m31_poly_eval_size),
   ("bb_add", Image.bb_add, Image.bb_add_size), ("bb_sub", Image.bb_sub, Image.bb_sub_size),
   ("bb_mul", Image.bb_mul, Image.bb_mul_size),
   ("ext2_mul_assign", Image.ext2_mul_assign, Image.ext2_mul_assign_size),
   ("ext4_mul_assign", Image.ext4_mul_assign, Image.ext4_mul_assign_size),
   ("ext4_add_assign", Image.ext4_add_assign, Image.ext4_add_assign_size),
   ("ext4_mul_add", Image.ext4_mul_add, Image.ext4_mul_add_size),
   ("ext4_horner", Image.ext4_horner, Image.ext4_horner_size),
   ("ext4_poly", Image.ext4_poly, Image.ext4_poly_size),
   ("finish_success", Image.finish_success, Image.finish_success_size),
   ("finish_success_extended", Image.finish_success_extended, Image.finish_success_extended_size),
   ("init", Image.init, Image.init_size), ("memcpy", Image.memcpy, Image.memcpy_size),
   -- constant tables (data, not code): their ROM copies
   ("COEFFS", Image.sirodata + (Image.COEFFS - Image.srodata), Image.COEFFS_size),
   ("COEFFS4", Image.sirodata + (Image.COEFFS4 - Image.srodata), Image.COEFFS4_size)]

/-- (block, address, size) of `ImageMop`. -/
def blocksMop : List (String × Nat × Nat) :=
  [("start", 0, ImageMop.main), ("main", ImageMop.main, ImageMop.main_size),
   ("inc", ImageMop.u32_inc, ImageMop.u32_inc_size), ("double", ImageMop.u32_double, ImageMop.u32_double_size),
   ("combine", ImageMop.u32_combine, ImageMop.u32_combine_size),
   ("add_mod", ImageMop.m31_add, ImageMop.m31_add_size), ("mul_mod", ImageMop.m31_mul, ImageMop.m31_mul_size),
   ("poly_eval", ImageMop.m31_poly_eval, ImageMop.m31_poly_eval_size),
   ("ext4_mul_add", ImageMop.ext4_mul_add, ImageMop.ext4_mul_add_size),
   ("ext4_horner", ImageMop.ext4_horner, ImageMop.ext4_horner_size),
   ("ext4_poly", ImageMop.ext4_poly, ImageMop.ext4_poly_size),
   ("finish_success", ImageMop.finish_success, ImageMop.finish_success_size),
   ("finish_success_extended", ImageMop.finish_success_extended, ImageMop.finish_success_extended_size),
   ("init", ImageMop.init, ImageMop.init_size), ("memcpy", ImageMop.memcpy, ImageMop.memcpy_size),
   ("COEFFS", ImageMop.sirodata + (ImageMop.COEFFS - ImageMop.srodata), ImageMop.COEFFS_size),
   ("COEFFS4", ImageMop.sirodata + (ImageMop.COEFFS4 - ImageMop.srodata), ImageMop.COEFFS4_size)]

def hex8 (w : Word) : String :=
  let s := String.ofList (Nat.toDigits 16 w.toNat)
  "".pushn '0' (8 - s.length) ++ s

/-- Blocks that are data, not code: no `decode` lemmas. -/
def dataBlocks : List String := ["COEFFS", "COEFFS4"]

def emit (n : String) (code : List Word) (data : Bool) : IO Unit := do
  IO.println s!"=== {n} ==="
  IO.println s!"import Slop.RV.Attr\n\n/-! GENERATED by lean/gen/words.sh from the images — do not edit. Block `{n}`: its words"
  IO.println s!"({code.length} words) and `decode` of each distinct one. No addresses here, so the file only changes when the block's bytes do. -/\n\nnamespace RV\n"
  IO.println s!"def Code.{n} : List Word :=\n  [{", ".intercalate (code.map fun w => s!"0x{hex8 w}#32")}]\n"
  unless data do
    for w in code.eraseDups do
      if let some i := decode w then
        IO.println s!"@[rv_word] theorem decode_{n}_{hex8 w} : decode 0x{hex8 w}#32 = some ({repr i}) := rfl"
  IO.println "\nend RV"

#eval do
  for (n, a, sz) in blocks do
    emit n (codeOf Image.bytes a sz) (dataBlocks.contains n)
  for (n, a, sz) in blocksMop do
    let code := codeOf ImageMop.bytes a sz
    let shared := blocks.any fun (n', a', sz') => n' == n && codeOf Image.bytes a' sz' == code
    unless shared do emit (n ++ "_mop") code (dataBlocks.contains n)

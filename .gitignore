# Base-commitment packing experiment verifier binaries (the blake sweep variants, the
# one-off `*_virtual` / `*_pack<k>` experiments): build them locally with
# tools/gkr_verifier/dump_bin.sh, never commit them.
tools/gkr_verifier/circuit_verifiers/*/*_pack*.elf
tools/gkr_verifier/circuit_verifiers/*/*_virtual.elf
tools/gkr_verifier/circuit_verifiers/*/*_mp.elf

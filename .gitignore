/.idea
/.vscode
/target
tools/gkr_verifier/target
/Cargo.lock
/output
**/.foundry/
rustc-ice-*.*
.DS_Store
**/.DS_Store
verifier_evm/private/*_gist.sh
__pycache__/
*.pyc
# Iteration outputs of the experiments_runner add/sub proving test
/experiments_runner/test_proofs/
# Local, regenerable proof caches (not tracked artifacts): the recursion examples'
# zlib-compressed JSON caches and the program_prover manual prove/verify tests' JSON.
/circuit_defs/prover_examples/*.json.zlib
/program_prover/tmp_*.json
# Generated on-disk dumps of RS codewords and merkle trees
# (prover `gkr::whir::rs_on_disk` coset files and `merkle_trees::on_disk` tree files).
*.rscw
*.tree

# Ignore locally generated verifier artifacts and flamegraphs.
tools/gkr_verifier/circuit_verifiers/*/*_pack*.elf
tools/gkr_verifier/circuit_verifiers/*/*_virtual.elf
prover/test_proofs/*_pack[0-9]_gkr_proof.json
prover/test_proofs/*_pack[0-9]_virtual_gkr_proof.json
prover/test_proofs/*_virtual_gkr_proof.json
verifier/src/generated/*/*_pack[0-9]/
verifier/src/generated/*/*_pack[0-9]_virtual/
verifier/src/generated/*/*_virtual/
verifier/gkr_flamegraph_*.svg
verifier/flamegraphs/**/*.svg
verifier/flamegraphs/**/cycles.txt

open Sail SailRV32 SailRV32.Functions Human

namespace Slop.Equiv
set_option maxHeartbeats 0

theorem dec_beq (w : BitVec 32) (σ : FState) (hs : Airbender.Sys σ) (h0 : Bits w 0 7 99) (h1 : Bits w 12 3 0) :
    runF (ext_decode w) σ = .ok (Airbender.toSail (.branch .eq (w.extractLsb' 15 5) (w.extractLsb' 20 5) ((w.extractLsb' 31 1 ++ w.extractLsb' 7 1 ++ w.extractLsb' 25 6 ++ w.extractLsb' 8 4 ++ (0 : BitVec 1)).signExtend 32))) σ := by
  walk_decoder hs
  close_row


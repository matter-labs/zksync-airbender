import Human.RV32
import Image
/-! Prints the files slop/Slop/RV/Code/<block>.lean (split by lean/gen/words.sh): per code block (function) its
words and one `decode` lemma per distinct word, so that a change in one function only touches its own file. -/
open RV
deriving instance Repr for Op, Cond, Instr

def wordAt (a : Nat) : Word :=
  let b := fun k => (Image.bytes[a + k]!).zeroExtend 32
  b 0 ||| b 1 <<< 8 ||| b 2 <<< 16 ||| b 3 <<< 24

def imageWords : List Word := (List.range (Image.bytes.size / 4)).map fun i => wordAt (4 * i)

def codeOf (a size : Nat) : List Word := (List.range (size / 4)).map fun i => wordAt (a + 4 * i)

def functions : List (String × Nat × Nat) :=
  [("boot", 0, Image.add_mod),  -- _start, _abs_start, _start_rust, _halt, main: everything before the functions
   ("inc", Image.inc, Image.inc_size), ("double", Image.double, Image.double_size),
   ("combine", Image.combine, Image.combine_size),
   ("add_mod", Image.add_mod, Image.add_mod_size), ("mul_mod", Image.mul_mod, Image.mul_mod_size),
   ("poly_eval", Image.poly_eval, Image.poly_eval_size),
   ("COEFFS", Image.COEFFS, Image.COEFFS_size)]  -- constant table (data, not code)

def hex8 (w : Word) : String :=
  let s := String.ofList (Nat.toDigits 16 w.toNat)
  "".pushn '0' (8 - s.length) ++ s

/-- Blocks that are data, not code: no `decode` lemmas. -/
def dataBlocks : List String := ["COEFFS"]

#eval do
  for (n, a, sz) in functions do
    let code := codeOf a sz
    IO.println s!"=== {n} ==="
    IO.println s!"import Slop.RV.Attr\n\n/-! GENERATED by lean/gen/words.sh from the image — do not edit. Block `{n}`: its words"
    IO.println s!"({code.length} words) and `decode` of each distinct one. No addresses here, so the file only changes when the block's bytes do. -/\n\nnamespace RV\n"
    IO.println s!"def Code.{n} : List Word :=\n  [{", ".intercalate (code.map fun w => s!"0x{hex8 w}#32")}]\n"
    unless dataBlocks.contains n do
      for w in code.eraseDups do
        if let some i := decode w then
          IO.println s!"@[rv_word] theorem decode_{n}_{hex8 w} : decode 0x{hex8 w}#32 = some ({repr i}) := rfl"
    IO.println "\nend RV"

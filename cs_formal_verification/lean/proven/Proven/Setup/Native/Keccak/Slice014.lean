module
public import Proven.Setup.Native.Keccak.Spec

@[expose] public section

namespace Airbender.Keccak.SetupProofs
open Airbender.Import.Setup Airbender.Import.Setup.Scan
-- `long_ok` tries several closing tactics; most proofs use the first.
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unusedSimpArgs false
-- The kernel checks of the `omega` proofs recurse deeply on the large row numbers.
set_option maxRecDepth 100000

/- Generated by scripts/generate_setup_scans.py: kernel scans of consecutive blocks. -/

theorem column3_long0 : Long.Ok column3 ⟨0, 0, 1, 65537, 0⟩ := by
  long_ok [column3, byRegion, rotationHigh, rotationLow, bySixteen]

theorem column3_long69633 : Long.Ok column3 ⟨69633, 0, 1, 4124671, 0⟩ := by
  long_ok [column3, byRegion, rotationHigh, rotationLow, bySixteen]

theorem column3_slice0 :
    AllOk column3 [⟨0, 0, 1, 65537, 0⟩, ⟨69633, 0, 1, 4124671, 0⟩] ∧
    SliceOk column3 Airbender.Compiler.NativeSetups.keccakSetup_col3 0 108 [⟨0, 0, 1, 65537, 0⟩, ⟨69633, 0, 1, 4124671, 0⟩] 0 4194304 :=
  ⟨⟨column3_long0, column3_long69633, trivial⟩, by decide +kernel⟩

theorem column4_long0 : Long.Ok column4 ⟨0, 0, 1, 65537, 0⟩ := by
  long_ok [column4, byRegion, rotationHigh, rotationLow, bySixteen]

theorem column4_long69633 : Long.Ok column4 ⟨69633, 0, 1, 4124671, 0⟩ := by
  long_ok [column4, byRegion, rotationHigh, rotationLow, bySixteen]

theorem column4_slice0 :
    AllOk column4 [⟨0, 0, 1, 65537, 0⟩, ⟨69633, 0, 1, 4124671, 0⟩] ∧
    SliceOk column4 Airbender.Compiler.NativeSetups.keccakSetup_col4 0 108 [⟨0, 0, 1, 65537, 0⟩, ⟨69633, 0, 1, 4124671, 0⟩] 0 4194304 :=
  ⟨⟨column4_long0, column4_long69633, trivial⟩, by decide +kernel⟩

end Airbender.Keccak.SetupProofs

/-- This batch retains every native scalar equation at these positions. -/
theorem gates011 (physical : GKRAddress → NativeArithmetic.F)
    (accepted : NativeArithmetic.Holds Airbender.Compiler.Captures.Bigint.imported.circuit physical) :
    ∀ gate ∈ [Airbender.Compiler.FullArithmeticNative.BigintCached.native.gate176, Airbender.Compiler.FullArithmeticNative.BigintCached.native.gate177, Airbender.Compiler.FullArithmeticNative.BigintCached.native.gate178, Airbender.Compiler.FullArithmeticNative.BigintCached.native.gate179, Airbender.Compiler.FullArithmeticNative.BigintCached.native.gate180, Airbender.Compiler.FullArithmeticNative.BigintCached.native.gate181], gate.expressionResidual (physical ∘ Airbender.Compiler.FullArithmeticNative.BigintCached.native.bank.address) = 0 :=
  (cons_holds (gate176 physical accepted) (cons_holds (gate177 physical accepted) (cons_holds (gate178 physical accepted) (cons_holds (gate179 physical accepted) (cons_holds (gate180 physical accepted) (cons_holds (gate181 physical accepted) (by intro gate member; cases member)))))))

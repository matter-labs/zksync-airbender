def encdec_csrop_backwards (arg_ : (BitVec 2)) : SailM csrop := do
  match arg_ with
  | 0b01 => (pure CSRRW)
  | 0b10 => (pure CSRRS)
  | 0b11 => (pure CSRRC)
  | _ =>
    (do
      «assert» false "Pattern match failure at unknown location"
      throw Error.Exit)

def encdec_csrop_forwards_matches (arg_ : csrop) : Bool :=
  match arg_ with
  | .CSRRW => true
  | .CSRRS => true
  | .CSRRC => true

def encdec_csrop_backwards_matches (arg_ : (BitVec 2)) : Bool :=
  match arg_ with
  | 0b01 => true
  | 0b10 => true
  | 0b11 => true
  | _ => false

/-- Type quantifiers: k_ex1822380_ : Bool, k_ex1822379_ : Bool -/
def csr_access_type (op : csrop) (rd_is_x0 : Bool) (rs1_imm_is_zero : Bool) : CSRAccessType :=
  match (op, rd_is_x0, rs1_imm_is_zero) with
  | (.CSRRW, true, _) => CSRWrite
  | (.CSRRW, false, _) => CSRReadWrite
  | (.CSRRS, _, true) => CSRRead
  | (.CSRRC, _, true) => CSRRead
  | (.CSRRS, _, false) => CSRReadWrite
  | (.CSRRC, _, false) => CSRReadWrite

def get_scountovf (priv : Privilege) : SailM (BitVec 32) := do
  let overflow := (zeros (n := 32))
  let overflow ← (( do
    let loop_i_lower := 3
    let loop_i_upper := 31
    let mut loop_vars := overflow
    for i in [loop_i_lower:loop_i_upper:1]i do
      let overflow := loop_vars
      loop_vars ← do
        (pure (BitVec.update overflow i
            (_get_HpmEvent_OF (Mk_HpmEvent (GetElem?.getElem! (← readReg mhpmevent) i)))))
    (pure loop_vars) ) : SailM (BitVec 32) )
  match priv with
  | .Machine => (pure overflow)
  | .Supervisor => (pure (overflow &&& (← readReg mcounteren)))
  | .VirtualSupervisor =>
    (pure (overflow &&& ((← readReg mcounteren) &&& (← readReg hcounteren))))
  | .User =>
    (internal_error "extensions/Sscofpmf/sscofpmf.sail" 65 "scountovf not readable from User mode")
  | .VirtualUser =>
    (internal_error "extensions/Sscofpmf/sscofpmf.sail" 66
      "scountovf not readable from VirtualUser mode")


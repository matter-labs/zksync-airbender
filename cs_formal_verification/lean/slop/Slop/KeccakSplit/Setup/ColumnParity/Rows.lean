/- Row meaning of the imported setup: every column decodes to its row formula on
   all 2^22 exported rows (generated by the import tooling). Short blocks come from the
   kernel walks; long blocks are affine or periodic shapes checked algebraically. -/

namespace Airbender.Keccak.Split.ColumnParity.SetupProofs
open Airbender.Import.Setup Airbender.Import.Setup.Proofs

set_option warningAsError true
set_option maxRecDepth 400000

theorem col0_total : total columnParitySetup_col0 = 4194304 := by decide +kernel

theorem col0_rows : ∀ n < 4194304, decode columnParitySetup_col0 n = col0Spec n := by
  rw [← col0_total]
  apply decode_eq
  intro p hp
  have le := placed_le p hp
  rw [col0_total] at le
  exact walkUpTo_sound col0_longs col0_walk p hp (by omega) (by omega)


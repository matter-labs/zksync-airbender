  have le := placed_le p hp
  rw [col2_total] at le
  by_cases h0 : p.1 < 65536
  · exact walkUpTo_sound col2_longs col2_part0 p hp (by omega) h0
  exact walkUpTo_sound col2_longs col2_part1 p hp (by omega) (by omega)


+-- Lean 4.34 compat: nested `do` blocks in `SailME` bodies may now be elaborated directly in
+-- `SailME`, where `throw Error.Exit` needs a `Sail.Error` exception instance.
+instance (priority := high) : MonadExcept (Sail.Error ue) (PreSailME ue exception) where
+  throw e := .impure (.ok (.inl (.error e))) Empty.elim
+  tryCatch eff h :=
+    let rec tryCatch eff h :=
+      match eff with
+        | .pure v => .pure v
+        | .impure (.ok (.inl (.error err))) _cont => h err
+        | .impure eff cont => .impure eff (fun v => tryCatch (cont v) h)
+    tryCatch eff h
+
+

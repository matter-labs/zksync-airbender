pragma solidity =0.8.36;

/// The L1 wrap setup tree's 512 nodes at level 9 (physical order) after a STOP byte; the
/// F1 verifier reads them with EXTCODECOPY and checks this code's hash once per call.
contract SetupFrontier {
    constructor() {
        bytes memory code = hex"";
        assembly {
            return(add(code, 32), mload(code))
        }
    }
}

import SailRV32
import Airbender.Review.Word

deriving instance DecidableEq for SailRV32.regidx

namespace Airbender.Reference.Sail
open _root_.Sail.ArchSem

/-- Reuse Sail's sequential interpreter; no local register or effect semantics. -/
abbrev run [Arch] {ε α : Type} (program : PreSailM ε α)
    (state : SequentialState Arch.register_type) :=
  (interpretSailEffects program).run state

end Airbender.Reference.Sail

namespace Airbender.Reference.RiscV
open Airbender.Arithmetic

/-- Tags selecting the upstream execution clauses covered by this pilot. -/
inductive Opcode where
  | add | addi | sub | lui | auipc
  deriving Repr, DecidableEq

/-- Original instruction tag and preprocessed words supplied to the arithmetic circuit. -/
structure RowInput where
  opcode : Opcode
  left : Word
  right : Word
  immediate : Word
  pc : Word

end Airbender.Reference.RiscV

namespace Airbender.Reference.RiscV.Sail
open _root_.Sail.ArchSem
open Airbender.Reference.Sail
open Airbender.Arithmetic

abbrev State := SequentialState SailRV32.RegisterType
abbrev zeroRegister : SailRV32.regidx := .Regidx 0

/-- An original decoded instruction and the preprocessed words exposed to the circuit.
    The Sail state is external input, not a circuit-generated witness. -/
structure Input where
  /-- Circuit operands after decoder preprocessing. -/
  row : RowInput
  rs1 : SailRV32.regidx
  rs2 : SailRV32.regidx
  rd : SailRV32.regidx
  /-- Original 12-bit encoding; for ADDI, `row.immediate` is its 32-bit sign extension. -/
  encodedImmediate : BitVec 12
  /-- Original U-type encoding; Sail appends twelve zero bits. -/
  encodedUpperImmediate : BitVec 20
  before : State

/-- Actual upstream execution clauses, generated by Sail for XLEN = 32. -/
def execution (input : Input) : SailRV32.SailM SailRV32.ExecutionResult :=
  match input.row.opcode with
  | .add => SailRV32.Functions.execute_RTYPE input.rs2 input.rs1 input.rd .ADD
  | .addi => SailRV32.Functions.execute_ITYPE input.encodedImmediate input.rs1 input.rd .ADDI
  | .sub => SailRV32.Functions.execute_RTYPE input.rs2 input.rs1 input.rd .SUB
  | .lui => SailRV32.Functions.execute_UTYPE input.encodedUpperImmediate input.rd .LUI
  | .auipc => SailRV32.Functions.execute_UTYPE input.encodedUpperImmediate input.rd .AUIPC

/-- Projection of the circuit's destination word through Sail's own register-write semantics. -/
def writeResult (input : Input) (output : Word) : SailRV32.SailM SailRV32.ExecutionResult := do
  SailRV32.Functions.wX_bits input.rd output.toBitVec
  pure SailRV32.Functions.RETIRE_SUCCESS

/-- Observable circuit outputs; all other architectural state is checked through Sail. -/
structure Output where
  destination : Word
  pc : Word

/-- Successful decoded four-byte path: upstream nextPC initialization, instruction
    execution, then upstream PC retirement. Fetch/interrupt/exception handling is excluded. -/
def normalExecution (input : Input) : SailRV32.SailM SailRV32.ExecutionResult := do
  SailRV32.Functions.normal_base_next_pc ()
  let result ← execution input
  SailRV32.Functions.tick_pc ()
  pure result

/-- Interpret the declared outputs using native Sail register writes. -/
def projectedStep (input : Input) (output : Output) : SailRV32.SailM SailRV32.ExecutionResult := do
  SailRV32.writeReg .nextPC output.pc.toBitVec
  let _ ← writeResult input output.destination
  SailRV32.writeReg .PC output.pc.toBitVec
  pure SailRV32.Functions.RETIRE_SUCCESS

/-- The actual decoded Sail path succeeds with exactly the projected state effects. -/
def spec (input : Input) (output : Output) : Prop :=
  ∃ after,
    run (normalExecution input) input.before = .ok SailRV32.Functions.RETIRE_SUCCESS after ∧
    run (projectedStep input output) input.before = .ok SailRV32.Functions.RETIRE_SUCCESS after

/-- Reads must succeed even for discarded writes. Their values agree with circuit
    words only when rd is nonzero, since x0 preprocessing replaces those words with zero. -/
structure Contract (input : Input) : Prop where
  leftRead : input.row.opcode = .add ∨ input.row.opcode = .addi ∨ input.row.opcode = .sub →
    ∃ value, run (SailRV32.Functions.rX_bits input.rs1) input.before = .ok value input.before ∧
      (input.rd ≠ zeroRegister → value = input.row.left.toBitVec)
  rightRead : input.row.opcode = .add ∨ input.row.opcode = .sub →
    ∃ value, run (SailRV32.Functions.rX_bits input.rs2) input.before = .ok value input.before ∧
      (input.rd ≠ zeroRegister → value = input.row.right.toBitVec)
  signExtension : input.rd ≠ zeroRegister → input.row.opcode = .addi →
    input.row.immediate.toBitVec = SailRV32.Functions.sign_extend (m := 32) input.encodedImmediate
  upperImmediate : input.rd ≠ zeroRegister → input.row.opcode = .lui ∨ input.row.opcode = .auipc →
    input.row.immediate.toBitVec = SailRV32.Functions.sign_extend (m := 32)
      (input.encodedUpperImmediate ++ BitVec.ofNat 12 0)
  pcRead : run (SailRV32.Functions.get_arch_pc ()) input.before =
    .ok input.row.pc.toBitVec input.before

end Airbender.Reference.RiscV.Sail

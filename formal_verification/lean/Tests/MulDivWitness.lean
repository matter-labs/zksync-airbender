def assignment (operation : Operation) (sample : Fin 5) (discarded : Bool)
    (i : Nat) : ZMod mersenne31Modulus :=
  if i = 7 then (if discarded then 0 else 1)
  else if i = 8 then (if discarded then 1 else 0)
  else if discarded && (i = 60 || i = 61) then 0
  else ((witnessValues operation sample)[i]?).getD 0

/-- Reuse exact Clean three-column membership for the concrete paired queries. -/
theorem byte_query_contains {a b c : Expression (ZMod mersenne31Modulus)}
    {env : _root_.Environment (ZMod mersenne31Modulus)}
    (first : (a.eval env).val < 256) (second : (b.eval env).val < 256)
    (padding : c.eval env = 0) :
    (fixed3 smallRangeTable #v[a,b,c]).Contains env := by
  simpa [Lookup.Contains,fixed3,Table.toRaw,smallRangeTable,Table.fromStatic,
    StaticTable.toTable,ProvableType.fromElements] using
    (small_range_contains first second padding)


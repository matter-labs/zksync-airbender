noncomputable def source25544 : Setup.Block := original.get ⟨72, by decide +kernel⟩

column_blocks_part part25544_0 from (UnifiedReduced.Setup.nativeRotate12Data.columns[(4 : Nat)]) start 231 stop 232
noncomputable def destination25544_0 : Setup.Block := part25544_0.get ⟨0, by decide +kernel⟩

noncomputable def target25544 : List Setup.Block := part25544_0

theorem follows25544 : blockTargetsFollow source25544 0 target25544 :=
  And.intro (by
    intro index bounded
    change source25544.get? (0 + index) = destination25544_0.get? index
    have same : source25544 = destination25544_0 := by rfl
    rw [same, Nat.zero_add]
  ) (True.intro)

theorem length25544 : (target25544.map Setup.Block.length).sum = source25544.length := by decide +kernel

